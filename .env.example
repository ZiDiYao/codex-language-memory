# Copy to .env, then supply your own password and external OAuth provider values.
# Compose expects a random hexadecimal password so the database URL needs no escaping.
POSTGRES_PASSWORD=
BACKEND_PORT=8080
PUBLIC_URL=https://memory.example.com
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=https://memory.example.com/mcp
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_REQUIRED_SCOPES=memory:read memory:write

# For running either Node.js or Python directly, also set DATABASE_URL.
# Node.js accepts postgresql://; Python also accepts the psycopg scheme below.
# DATABASE_URL=postgresql+psycopg://language_memory:YOUR_HEXADECIMAL_PASSWORD@127.0.0.1:5432/language_memory
# Development only; permits HTTP loopback configuration, never anonymous access:
# CLOUD_ALLOW_INSECURE_LOCAL=true

# Node backend only: Codex identifies the learning target; this model enriches it later.
# Keep keys on the backend, never in the desktop plugin or browser configuration.
SAYROVE_ENRICHMENT_PROVIDER=deepseek
SAYROVE_ENRICHMENT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Explicit OpenAI selection uses OPENAI_API_KEY and your chosen OpenAI model.
# OPENAI_API_KEY=
# Generic Chat JSON providers require provider=openai-compatible plus all three:
# SAYROVE_ENRICHMENT_MODEL=your-model-id
# SAYROVE_ENRICHMENT_BASE_URL=https://your-provider.example/v1
# SAYROVE_ENRICHMENT_API_KEY=
