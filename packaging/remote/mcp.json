{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "language_memory": {
      "type": "streamable-http",
      "url": "https://language-memory-api.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["memory:read", "memory:write", "offline_access"],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
